# Copy to .env for local builds. Production values live in netlify.toml and the Netlify UI.

# Search engine verification (HTML meta tag "content" value only). Leave empty to omit the tag.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# Contact form function (netlify/functions/sendEmail.ts). Set these in the Netlify UI.
RESEND_API_KEY=
CONTACT_EMAIL=mathengevan@gmail.com
CONTACT_FROM=ekariuki@britech.co.ke
